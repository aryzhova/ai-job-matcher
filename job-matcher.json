      "id": "8ba97f5e-cf8f-4866-a82e-ef8b6022cfd7",
      "name": "HTTP Request2"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const resumeText = $('Edit Fields').first().json.resumeText || '';\n  const jobTitle = item.json.title || '';\n  const jobDescription = (item.json.description || '').replace(/<[^>]*>/g, '').substring(0, 800);\n\n  const promptText = `Резюме кандидата: ${resumeText}. Вакансия: ${jobTitle}. ${jobDescription}. Оцени соответствие от 0 до 100. Ответь строго в формате JSON без пояснений: {\"score\": число, \"reason\": \"одно предложение\"}`;\n\n  const body = {\n    model: \"llama3.2\",\n    prompt: promptText,\n    stream: false\n  };\n\n  return {\n    json: {\n      ...item.json,\n      llmRequestBody: body\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        112
      ],
      "id": "993dc7d1-f29d-4766-adbf-245e26a9952c",
      "name": "JSON body builder"
    },
    {
      "parameters": {
        "jsCode": "const originalItems = $('JSON body builder').all();\n\nreturn $input.all().map((item, index) => {\n  let parsed;\n  \n  if (!item.json.response) {\n    parsed = { score: 0, reason: 'Ошибка при обращении к LLM' };\n  } else {\n    try {\n      parsed = JSON.parse(item.json.response);\n    } catch (e) {\n      const match = item.json.response.match(/\\{[\\s\\S]*\\}/);\n      parsed = match ? JSON.parse(match[0]) : { score: 0, reason: 'Не удалось распарсить ответ' };\n    }\n  }\n\n  return {\n    json: {\n      title: originalItems[index]?.json?.title,\n      description: originalItems[index]?.json?.description,\n      llm_score: parsed.score,\n      llm_reason: parsed.reason\n    }\n  };\n}).sort((a, b) => b.json.llm_score - a.json.llm_score);"
      },
