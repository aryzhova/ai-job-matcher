    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nlet html = '<h2>Подходящие вакансии на сегодня</h2>';\n\nfor (const item of items) {\n  html += `\n    <div style=\"margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 8px;\">\n      <h3>${item.json.title}</h3>\n      <p><strong>Оценка соответствия:</strong> ${item.json.llm_score}/100</p>\n      <p><strong>Почему подходит:</strong> ${item.json.llm_reason}</p>\n    </div>\n  `;\n}\n\nreturn [{\n  json: {\n    emailHtml: html,\n    jobCount: items.length\n  }\n}];"
      },
