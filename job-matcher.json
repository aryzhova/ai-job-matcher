      "id": "14cfaae9-d880-4a48-8bab-d6f93a25d5e9",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "\nfunction cosineSimilarity(vecA, vecB) {\n  let dotProduct = 0, normA = 0, normB = 0;\n  for (let i = 0; i < vecA.length; i++) {\n    dotProduct += vecA[i] * vecB[i];\n    normA += vecA[i] * vecA[i];\n    normB += vecB[i] * vecB[i];\n  }\n  return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));\n}\n\n// Получаем вектор резюме из узла Edit Fields \nconst resumeEmbedding = $('Edit Fields').first().json.resumeEmbedding;\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const jobEmbedding = item.json.embedding;\n  const score = cosineSimilarity(resumeEmbedding, jobEmbedding);\n  \n  results.push({\n    title: item.json.title || 'N/A',\n    description: item.json.description,\n    similarity_score: score\n  });\n}\n\nresults.sort((a, b) => b.similarity_score - a.similarity_score);\n\nreturn results.map(r => ({ json: r }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -144
      ],
      "id": "3d2e76a9-ff82-4f31-be76-3357a869c69d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const embeddingItems = $input.all();\nconst originalItems = $('Split Out').all();\n\nreturn embeddingItems.map((item, index) => {\n  return {\n    json: {\n      title: originalItems[index].json.title,\n      description: originalItems[index].json.description.replace(/<[^>]*>/g, ''),\n      embedding: item.json.embedding\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
